; TRAPF 26 — native Godot project
; Open with Godot 4.3 or newer. Mobile renderer keeps the target Android device in mind.
config_version=5

[application]
config/name="TRAPF 26"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.35, 0.58, 0.72, 1)

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":Shift)]}
pass_ball={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":80)]}
shoot_ball={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":Space)]}
